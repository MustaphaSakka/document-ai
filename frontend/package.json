{
  "name": "document-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src cypress",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"cypress/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"cypress/**/*.ts\"",
    "test:e2e": "start-server-and-test dev http://localhost:5173 cypress:run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "start-server-and-test": "^3.0.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.12"
  }
}
