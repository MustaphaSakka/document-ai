# AWS Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=my-document-bucket

# PostgreSQL
# Connection string used by the API and by `npm run migrate`.
# The values below match the container in docker-compose.yml. They are local
# development defaults, not secrets; never commit real credentials.
DATABASE_URL=postgresql://document_ai:document_ai@localhost:5432/document_ai

# The test suite does not read this file: `vitest.config.ts` sets its own
# DATABASE_URL, pointing at the document_ai_test database.
